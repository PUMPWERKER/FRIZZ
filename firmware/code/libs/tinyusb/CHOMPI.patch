+#endif
+
 #if CFG_TUD_AUDIO_ENABLE_EP_OUT && CFG_TUD_AUDIO_ENABLE_FEEDBACK_EP
 // This function is called once a transmit of a feedback packet was successfully completed. Here, we get the next feedback value to be sent
 static inline bool audiod_fb_send(uint8_t func_id, bool is_isr) {
   audiod_function_t *audio = &_audiod_fct[func_id];
   uint8_t uac_version = tud_audio_n_version(func_id);
+  // CHOMPI: CFG_TUD_AUDIO20_FS_FEEDBACK_10_14 sends UAC2 full speed feedback as the spec's 3 byte 10.14 too.
+  // macOS reads 3 bytes there and reports the 4 byte 16.16 one as babble.
+#if CFG_TUD_AUDIO20_FS_FEEDBACK_10_14
+  const bool fb_10_14 = uac_version == 1 || tud_speed_get() == TUSB_SPEED_FULL;
+#else
+  const bool fb_10_14 = uac_version == 1;
+#endif
   // Format the feedback value
-  if (uac_version == 1) {
+  if (fb_10_14) {
     uint8_t *fb = (uint8_t *) audio->fb_buf;
 
     // For FS format is 10.14
@@ -607,7 +619,7 @@
     *audio->fb_buf = audio->feedback.value;
   }
 
-  return usbd_edpt_xfer(audio->rhport, audio->ep_fb, (uint8_t *) audio->fb_buf, uac_version == 1 ? 3 : 4, is_isr);
+  return usbd_edpt_xfer(audio->rhport, audio->ep_fb, (uint8_t *) audio->fb_buf, fb_10_14 ? 3 : 4, is_isr);
 }
 
