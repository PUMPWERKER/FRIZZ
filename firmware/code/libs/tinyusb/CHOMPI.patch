# The CHOMPI changes in this vendored TinyUSB against upstream 0.21.0 (dae3f9a), as lost-tty/CHOMPI made them;
# the rest of src/ is upstream byte for byte (only the other chips' ports left out). diff -u, upstream first.
--- src/class/audio/audio_device.c	2026-10-14 12:01:04.698288048 +0200
+++ src/class/audio/audio_device.c	2026-10-14 10:37:22.675978882 +0200
@@ -589,13 +589,25 @@
